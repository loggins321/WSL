# Include other.conf
include other.conf
globinclude kitty.d/**/*.conf
envinclude KITTY_CONF_*
geninclude dynamic.py

font_family      JetBrainsMono Nerd Font Mono, Sazanami Mincho, monospace
font_size        10.5
italic_font      auto
bold_italic_font auto

cursor_trail 1

remember_window_size  yes

background_opacity 1
background_blur 1

# BEGIN_KITTY_THEME
# Alien Blood
include current-theme.conf
# END_KITTY_THEME
